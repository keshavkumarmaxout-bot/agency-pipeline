# ---- Anthropic ----
# Either set a key here, or run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# ---- Postgres ----
DATABASE_URL=postgresql://user:pass@localhost:5432/agency_pipeline

# ---- Safety switches ----
# DRY_RUN=true routes every outbound send to TEST_INBOX and stubs e-sign.
DRY_RUN=true
TEST_INBOX=you+pipelinetest@example.com

# Hard ceiling on outbound sends per day, enforced by the sender worker.
DAILY_SEND_CAP=50
PER_DOMAIN_SEND_CAP=3

# ---- Google (Phase 1/2) ----
GOOGLE_SERVICE_ACCOUNT_JSON=
LEADS_SHEET_ID=
LEADS_SHEET_RANGE=Leads!A:Z
GMAIL_SENDER=hello@youragency.com

# ---- Compliance footer (required in every outbound email) ----
COMPANY_LEGAL_NAME=Your Agency Ltd
COMPANY_POSTAL_ADDRESS=1 Example Street, City, Country
UNSUBSCRIBE_BASE_URL=https://youragency.com/unsubscribe
